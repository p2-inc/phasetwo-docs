{
  "realm": "policies",
  "keycloakVersion": "26.8.1",
  "accessTokenLifespan": 300,
  "revokeRefreshToken": false,
  "offlineSessionMaxLifespanEnabled": false,
  "clientPolicies": {
    "policies": [
      {
        "name": "pkce-public",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-access-type",
            "configuration": {
              "type": [
                "public"
              ]
            }
          }
        ],
        "profiles": [
          "pkce"
        ]
      },
      {
        "name": "no-ropc-by-attribute",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-attributes",
            "configuration": {
              "is-negative-logic": false,
              "attributes": "[{\"key\":\"policy.tier\",\"value\":\"strict\"}]"
            }
          }
        ],
        "profiles": [
          "no-ropc"
        ]
      },
      {
        "name": "no-implicit-partner-role",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-roles",
            "configuration": {
              "roles": [
                "partner-app"
              ]
            }
          }
        ],
        "profiles": [
          "no-implicit"
        ]
      },
      {
        "name": "pkce-by-scope",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-scopes",
            "configuration": {
              "type": "Optional",
              "scopes": [
                "offline_access"
              ]
            }
          }
        ],
        "profiles": [
          "pkce"
        ]
      },
      {
        "name": "ropc-not-public",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-access-type",
            "configuration": {
              "type": [
                "public"
              ],
              "is-negative-logic": true
            }
          },
          {
            "condition": "grant-type",
            "configuration": {
              "grant_types": [
                "password"
              ]
            }
          }
        ],
        "profiles": [
          "no-ropc"
        ]
      },
      {
        "name": "on-save-from-host",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-updater-source-host",
            "configuration": {
              "trusted-hosts": [
                "ci.example.com"
              ]
            }
          }
        ],
        "profiles": [
          "pkce"
        ]
      },
      {
        "name": "disabled-any",
        "enabled": false,
        "conditions": [
          {
            "condition": "any-client",
            "configuration": {}
          }
        ],
        "profiles": [
          "oauth-2-1-for-public-client"
        ]
      }
    ]
  },
  "clientProfiles": {
    "profiles": [
      {
        "name": "pkce",
        "executors": [
          {
            "executor": "pkce-enforcer",
            "configuration": {
              "auto-configure": "false"
            }
          }
        ]
      },
      {
        "name": "no-ropc",
        "executors": [
          {
            "executor": "reject-ropc-grant",
            "configuration": {
              "auto-configure": "false"
            }
          }
        ]
      },
      {
        "name": "no-implicit",
        "executors": [
          {
            "executor": "reject-implicit-grant",
            "configuration": {
              "auto-configure": "false"
            }
          }
        ]
      }
    ]
  },
  "clients": [
